# Database — point at your local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productivity?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Seeded single user (used by prisma/seed.ts)
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="changeme123"
SEED_USER_NAME="You"

# Claude auth. Mode is stored in DB (AppSetting.claudeAuthMode).
# Only used when mode = API_KEY. Empty = use local Claude Code subscription.
ANTHROPIC_API_KEY=""

# Local data root (assets + task outputs). Used by the "local" storage driver.
DATA_ROOT="./data"

# Blob storage backend: "local" (data/ on disk) or "s3" (any S3-compatible
# object store — Cloudflare R2 in production, MinIO for local testing).
STORAGE_DRIVER="local"

# Object store — required when STORAGE_DRIVER="s3".
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO:         http://localhost:9000
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="retroz"
# MinIO requires path-style addressing; R2 accepts either.
S3_FORCE_PATH_STYLE="true"

# Public base URL of the bucket, no trailing slash.
# R2:    https://pub-xxxx.r2.dev  (or a custom domain)
# MinIO: http://localhost:9000/retroz
# Must be NEXT_PUBLIC_: client components build image URLs from it. The bucket
# needs anonymous read access, plus CORS allowing the app origin (the browser
# loads woff2 font files cross-origin).
NEXT_PUBLIC_S3_PUBLIC_BASE=""
